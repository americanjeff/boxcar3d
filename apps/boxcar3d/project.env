# Single source of truth for this app's binary name and window/page title.
# Sourced by tools/build_app.sh. APP is the binary/output name; TITLE is the
# window title (native) and the page title (wasm).
#
# boxcar3d builds both targets: `build_app.sh native` (windowed) and
# `build_app.sh wasm` (the browser build; `just publish` stages a clean
# pushable web copy in build/web/).
#
# ML_LIBS names the engine's ML archives this app links (a space-separated
# subset of "kann cmaes neat"; unset = all three). Empty here: boxcar3d uses
# none — its evolution is the hand-rolled Odin in src/evolve.odin, not the
# NEAT C library.
APP="boxcar3d"
TITLE="Boxcar3d"
ML_LIBS=""
# Published site (og: link-preview tags): SITE_URL is the absolute origin,
# OG_IMAGE ships from the site root (apps/<app>/web/ is copied there),
# OG_DESCRIPTION is the one-line preview copy.
SITE_URL="https://boxcar3d.com"
OG_IMAGE="funcar.png"
OG_DESCRIPTION="Simulated evolution of cars built on Box3D physics"
